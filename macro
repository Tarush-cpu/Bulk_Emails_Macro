Sub SendBulkEmails_FromDraft()

    Dim OutApp As Object
    Dim OutMail As Object
    Dim OutAccount As Object
    Dim Accounts As Object

    Dim ws As Worksheet
    Dim lastRow As Long
    Dim i As Long

    Dim draftText As String
    Dim finalBody As String
    Dim subjectText As String

    Dim accList As String
    Dim accChoice As Variant
    Dim accIndex As Integer

    '--- Worksheet reference ---
    Set ws = ThisWorkbook.Sheets(1) 'change if needed
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row

    '--- Attach to Outlook ---
    On Error Resume Next
    Set OutApp = GetObject(, "Outlook.Application")
    If OutApp Is Nothing Then
        Set OutApp = CreateObject("Outlook.Application")
    End If
    On Error GoTo 0

    Set Accounts = OutApp.Session.Accounts

    '--- Ask user to choose Outlook account ---
    accList = "Choose Outlook account number:" & vbCrLf & vbCrLf
    For i = 1 To Accounts.Count
        accList = accList & i & ". " & Accounts.Item(i).SmtpAddress & vbCrLf
    Next i

    accChoice = InputBox(accList, "Outlook Account Selection")

    If accChoice = "" Or Not IsNumeric(accChoice) Then Exit Sub
    accIndex = CInt(accChoice)

    If accIndex < 1 Or accIndex > Accounts.Count Then
        MsgBox "Invalid account selected.", vbCritical
        Exit Sub
    End If

    Set OutAccount = Accounts.Item(accIndex)

    '--- Loop through all rows ---
    
    draftText = ws.Cells(2, 5).Value
    subjectText = ws.Cells(2, 4).Value 'Draft
    
    For i = 2 To lastRow

        If ws.Cells(i, 3).Value <> "" Then   'Email column

            '--- Replace placeholders ---
            finalBody = draftText
            finalBody = Replace(finalBody, "{{NAME}}", ws.Cells(i, 1).Value)
            finalBody = Replace(finalBody, "{{COMPANY}}", ws.Cells(i, 2).Value)

            Set OutMail = OutApp.CreateItem(0)

            With OutMail
                .To = ws.Cells(i, 3).Value
                .Subject = subjectText
                .Body = finalBody
                .SendUsingAccount = OutAccount

                'SAFETY MODE
                .Send   'change to .Send after testing
            End With

            Set OutMail = Nothing

        End If
    Next i

    MsgBox "All emails processed successfully!", vbInformation

End Sub
